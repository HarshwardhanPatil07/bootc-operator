{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>bootc-dev/infra:renovate-shared-config.json"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "(?:^|\\n)RELEASED_OPERATOR_TAG[ \\t]+\\?=[ \\t]*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "bootc-dev/bootc-operator",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": [
        "(?:BINK_COMMIT|bink-commit):\\s+(?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "bootc-dev/bink",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/bootc-dev/bink",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": [
        "kube-minor: \"(?<currentValue>\\d+\\.\\d+)\"\\s+digest: (?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "ghcr.io/bootc-dev/bink/node",
      "datasourceTemplate": "docker"
    }
  ]
}
